{
  "name": "@tgsnake/core",
  "version": "2.0.0",
  "description": "Pure Telegram MTProto library for Javascript or Typescript.",
  "main": "./dist/mod.js",
  "type": "module",
  "types": "./dist/mod.d.ts",
  "scripts": {
    "build": "tsc",
    "build:license": "node ./generator/license",
    "build:chglog": "node ./generator/chglog",
    "prepare": "yarn build",
    "prettier": "NODE_OPTIONS=--max_old_space_size=4096 prettier -w ."
  },
  "homepage": "https://tgsnake.js.org",
  "keywords": [
    "tgsnake",
    "mtproto",
    "telegram"
  ],
  "bugs": "https://github.com/tgsnake/core/issues",
  "repository": "https://github.com/tgsnake/core",
  "author": "butthx",
  "files": [
    "dist/**/**"
  ],
  "license": "(GPL-3.0 OR LGPL-3.0)",
  "engineStrict": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=6.0.0",
    "yarn": ">=1.0.0",
    "deno": ">=1.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "yarn@4.15.0",
  "dependencies": {
    "@tgsnake/bytesio": "^2.0.1",
    "@tgsnake/log": "^2.0.1",
    "async-mutex": "^0.5.0",
    "big-integer": "^1.6.52",
    "socks": "^2.8.9"
  },
  "devDependencies": {
    "@tgsnake/skema": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@tgsnake/skema": "^2.0.0"
  },
  "isBeta": false,
  "isPrivate": false
}
